{
  "name": "ecg",
  "version": "1.0.0",
  "description": "Express CRUD Generator",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "ecg": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "build:test": "tsc -p tsconfig.test.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "npm run build:test && node --test dist-test/test",
    "start": "node dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "express",
    "crud",
    "generator",
    "cli",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dev-himel-0o0/ECG.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "express": "^5.3.0",
    "typescript": "^7.0.2"
  }
}
